<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GestorEmpleadosMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:GestorEmpleadosMaui.Pages"
    Title="GestorEmpleadosMaui">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Empleados"
            ContentTemplate="{DataTemplate pages:EmployeePage}"
            Route="EmployeePage" />

        <ShellContent
            Title="Departamentos"
            ContentTemplate="{DataTemplate pages:DepartmentPage}"
            Route="DepartmentPage"/>

        <ShellContent
            Title="Estadísticas"
            ContentTemplate="{DataTemplate pages:GraphPage}"
            Route="GraphPage"/>
        
        <ShellContent
            Title="Acerca de"
            ContentTemplate="{DataTemplate pages:AboutPage}"
            Route="AboutPage"/>
    </TabBar>
</Shell>
