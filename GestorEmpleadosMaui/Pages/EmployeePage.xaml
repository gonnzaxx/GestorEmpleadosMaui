<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestorEmpleadosMaui.Pages.EmployeePage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:GestorEmpleadosMaui.Templates"
             Title="Empleados">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior 
            EventName="Appearing" 
            Command="{Binding RefreshCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *" Padding="10">

        
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
            <Label Grid.Column="0" 
                   Text="Directorio de Empleados" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1" 
                    Text="+ Nuevo"
                    Command="{Binding AddEmployeeCommand}"
                    BackgroundColor="{StaticResource Primary}"/>
        </Grid>

        
        <CollectionView Grid.Row="1" 
                            x:Name="EmployeesCollectionView"
                            ItemsSource="{Binding Employees}"
                            SelectedItem="{Binding SelectedEmployee}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding ShowDetailCommand}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <controls:EmployeeCardTemplate/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No hay empleados registrados" 
                               FontSize="18"
                               HorizontalOptions="Center"/>
                        <Button Text="Agregar empleado"
                                Command="{Binding AddEmployeeCommand}"
                                Margin="0,20,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

        </CollectionView>
        
    </Grid>
</ContentPage>